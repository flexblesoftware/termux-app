<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color: Neon Cyan Accent -->
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorPrimaryVariant">#0A0F1D</item>

        <item name="android:windowBackground">#0A0E17</item>

        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer: Modern Obsidian Card -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">#0A0F1D</item>
        <item name="termuxActivityDrawerImageTint">#00E5FF</item>

        <!-- Extra keys colors: Modern Cyber Theme -->
        <item name="extraKeysButtonTextColor">#00E5FF</item>
        <item name="extraKeysButtonActiveTextColor">#00FFA3</item>
        <item name="extraKeysButtonBackgroundColor">#0D1322</item>
        <item name="extraKeysButtonActiveBackgroundColor">#1E293B</item>
    </style>

</resources>
